; SPDX-License-Identifier: GPL-2.0-or-later
;
; Toshiba MEUSBPCA USB to PC Card Adapter (DataFab DF-USB01)
; Windows 98 Second Edition and Windows Millennium Edition.
;
; Binds Microsoft's USBSTOR.SYS to the adapter by VID/PID, forces Bulk-Only
; transport, puts USBNTMAP.SYS above it as Windows Me does, and meusbpca.sys
; beneath it as a lower filter.
;
; USBSTOR.SYS, USBNTMAP.SYS and USBMPHLP.PDR are Windows Me files:
;   - On Windows Me, Setup finds them in Windows' own installation files.
;   - On Windows 98SE, put all three next to this INF first. GETMEFIL.BAT
;     extracts USBSTOR.SYS and USBNTMAP.SYS from a Windows Me CD.
;     USBMPHLP.PDR must be the patched copy from the NUSB 3.3 package; the
;     Windows Me original does not start the disk on Windows 98SE. This INF
;     also installs MEUSB9XD.INF, which Windows then uses for the disk the
;     adapter exposes.
; This package ships no Microsoft files.
;
; Tested on Windows Me and Windows 98SE.

[Version]
Signature="$CHICAGO$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
LayoutFile=layout.inf, layout1.inf, layout2.inf
DriverVer=10/04/2026,0.2.2.0

[Manufacturer]
%Manufacturer%=Models

[Models]
%DeviceName%=Install, USB\VID_07C4&PID_A006

[SourceDisksNames]
1=%DiskName%,,

[SourceDisksFiles]
meusbpca.sys=1
meusb9xd.inf=1

[DestinationDirs]
DefaultDestDir=10,System32\Drivers
PortDriver.CopyFiles=12
DiskInf.CopyFiles=17

[Install]
CopyFiles=Filter.CopyFiles, UsbStor.CopyFiles, PortDriver.CopyFiles, DiskInf.CopyFiles
AddReg=Install.AddReg

[Filter.CopyFiles]
meusbpca.sys

[UsbStor.CopyFiles]
USBSTOR.SYS
USBNTMAP.SYS

; The disk USBSTOR.SYS reports is a separate device. On Windows 98SE its
; driver information must already be in place when the disk appears, or
; Windows installs the disk with its own NTMAP.INF, which belongs to a
; different mapper and crashes with this one.
[PortDriver.CopyFiles]
USBMPHLP.PDR

[DiskInf.CopyFiles]
meusb9xd.inf

[Install.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,USBSTOR.SYS
HKR,,DriverFlags,0x00010001,0x00000001

[Install.HW]
AddReg=Install.HW.AddReg

[Install.HW.AddReg]
HKR,,UpperFilters,0,"USBNTMAP.SYS"
HKR,,LowerFilters,0,"meusbpca.sys"

[Strings]
Provider="Xlfdll Workstation"
Manufacturer="Toshiba"
DeviceName="Toshiba MEUSBPCA USB to PC Card Adapter"
DiskName="MEUSBPCA driver disk"
