; SPDX-License-Identifier: GPL-2.0-or-later
;
; Toshiba MEUSBPCA USB to PC Card adapter (DataFab DF-USB01)
;
; Binds Microsoft's usbstor.sys to the adapter by VID/PID, forces Bulk-Only
; transport, and puts meusbpca.sys beneath it as a lower filter.
;
; Windows 98SE needs the Windows ME USB storage files installed first
; (USBSTOR.SYS, USBNTMAP.SYS, USBMPHLP.PDR and their INFs, or NUSB).
; This package ships no Microsoft files.
;
; UNTESTED: the 9x sections follow Microsoft's own Win9x usbstor INFs, but
; have not been tried on any system yet.

[Version]
Signature="$CHICAGO$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
DriverVer=10/03/2026,0.1.0.0

[Manufacturer]
%Manufacturer%=Models

[Models]
%DeviceName%=Install, USB\VID_07C4&PID_A006

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
meusbpca.sys=1

[DestinationDirs]
DefaultDestDir=10,System32\Drivers

[Filter.CopyFiles]
meusbpca.sys

; ---- Windows 98SE / ME ----

[Install]
CopyFiles=Filter.CopyFiles
AddReg=Install.AddReg

[Install.AddReg]
HKR,,DevLoader,,*NTKERN
HKR,,NTMPDriver,,USBSTOR.SYS
HKR,,DriverFlags,0x00010001,0x00000001

[Install.HW]
AddReg=Install.HW.AddReg

[Install.HW.AddReg]
HKR,,LowerFilters,0,meusbpca.sys

; ---- Windows 2000 and later ----

[Install.NT]
CopyFiles=Filter.CopyFiles
AddReg=Install.NT.AddReg

[Install.NT.AddReg]
HKR,,DriverFlags,0x00010001,0x00000001

[Install.NT.HW]
AddReg=Install.NT.HW.AddReg

[Install.NT.HW.AddReg]
HKR,,LowerFilters,0x00010000,meusbpca

[Install.NT.Services]
AddService=USBSTOR,0x00000002,UsbStor.Service
AddService=meusbpca,,Filter.Service

[UsbStor.Service]
DisplayName=%UsbStorName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\USBSTOR.SYS

[Filter.Service]
DisplayName=%DeviceName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%12%\meusbpca.sys

[Strings]
Provider="MEUSBPCA project"
Manufacturer="Toshiba"
DeviceName="Toshiba MEUSBPCA USB to PC Card adapter"
UsbStorName="USB Mass Storage Driver"
DiskName="MEUSBPCA driver disk"
